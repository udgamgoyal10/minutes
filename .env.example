# ============================================
# Meeting Minutes Automation — server config
# Copy to .env and fill in. NEVER commit .env.
# ============================================

# ---- App ----
NODE_ENV=development
PORT=8787
PUBLIC_URL=http://localhost:5173

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ---- Storage ----
SQLITE_PATH=./data/minutes.db
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

# ---- AI: Ollama (local, JKP internal) ----
OLLAMA_BASE_URL=http://10.3.8.14:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# ---- AI: Anthropic Claude ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- AI: Google Gemini (REQUIRED — powers OCR) ----
GOOGLE_API_KEY=
GEMINI_OCR_MODEL=gemini-3.5-flash
GEMINI_CHAT_MODEL=gemini-3.5-flash-latest

# ---- AI: OpenAI (optional, auto-enables when set) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ---- Cloudflare Tunnel (optional) ----
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Ops only (not read by app) ----
# OLLAMA_SSH_USER=udgamai
# OLLAMA_SSH_HOST=10.3.8.14
